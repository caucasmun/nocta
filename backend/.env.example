# Локальная разработка (Postgres на машине):
# DATABASE_URL можно не задавать — используется дефолт из db.js
# Или явно:
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/postgres
DB_SSL=false

# Прод / Render + Supabase:
# Скопируйте URI из Supabase → Project Settings → Database → Connect
# Рекомендуется Session pooler (порт 5432 на host *.pooler.supabase.com)
# или Transaction pooler (порт 6543)
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_SSL не нужен — для облака SSL включается автоматически

PORT=5000
